rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: User must be authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Access is restricted to the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents: users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Nap logs: nap_logs/{napId}
    match /nap_logs/{napId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Daily sleep logs: sleep_logs/{logId}
    match /sleep_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Commitments: commitments/{commitmentId}
    match /commitments/{commitmentId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
